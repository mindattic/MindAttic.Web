{
  "$comment": "Canonical map of which MindAttic.UiUx components flow to each downstream subscriber, with per-subscriber configuration. Sync scripts read this file to drive their splicing -- edit THIS file (not the sync scripts) when adding or removing subscriptions. Marker names are base names: the html-inline kinds (mindattic.com, MindAttic.Psst legal pages) splice on the bare marker, while the blazor-wwwroot kind (Prose) appends a .CSS suffix. NOTE: the three sites (mindattic.com, ryandebraal.com, mindatticcares.com) load fonts, logos and the engine from jsDelivr at the tag the MindAttic.Deploy linked deploy pins; only mindattic.com's CYBERSPACE block is spliced. The former catalog landing pages and Claudia/ChiMesh long-form builds were retired by MindAttic.Deploy DEP-A6 (2026-10-03; see docs/AMENDMENTS.md MAU-A7) -- each repo's GitHub README is its project page.",

  "components": {
    "OutfitFont":  { "type": "font-css",    "marker": "OUTFITFONT",  "cssFile": "Components/OutfitFont/outfit-font.css",   "jsonFile": "Components/OutfitFont/outfit-font.json", "htmlFile": "Components/OutfitFont/outfit-font.html" },
    "AtticFont":   { "type": "font-css",    "marker": "ATTICFONT",   "cssFile": "Components/AtticFont/attic-font.css",     "jsonFile": "Components/AtticFont/attic-font.json",   "htmlFile": "Components/AtticFont/attic-font.html"  },
    "BackHomeM":   { "type": "static-css",  "marker": "BACKHOMEM",   "cssFile": "Components/BackHomeM/back-home-m.css" },
    "Cyberspace":  { "type": "html-bundle", "marker": "CYBERSPACE",  "htmlFile": "Components/Cyberspace/frontpage.html",   "cssFile": "Components/Cyberspace/frontpage.css",     "jsFiles": ["Components/Cyberspace/loader.js", "Components/Cyberspace/tv-static.js", "Components/Cyberspace/home-bg.js", "Components/SacredGeometry/sacred-geometry.js", "Components/Cyberspace/console-bg.js"], "assetsDir": "Components/Cyberspace/assets" },
    "PinFooter":   { "type": "html-bundle", "marker": "PINFOOTER",   "htmlFile": "Components/PinFooter/pin-footer.html",   "cssFile": "Components/PinFooter/pin-footer.css",     "jsFiles": ["Components/PinFooter/pin-footer.js"] },
    "WebSnapshot": { "type": "html-bundle", "marker": "WEBSNAPSHOT",                                                       "cssFile": "Components/WebSnapshot/web-snapshot.css", "jsFiles": ["Components/WebSnapshot/web-snapshot-viewer.js"] },
    "UserLogin":   { "type": "html-bundle", "marker": "USERLOGIN",                                                         "cssFile": "Components/UserLogin/user-login.css",     "jsFiles": ["Components/UserLogin/user-login.js"] },
    "UserCircle":  { "type": "html-bundle", "marker": "USERCIRCLE",                                                        "cssFile": "Components/UserCircle/user-circle.css",   "jsFiles": ["Components/UserCircle/user-circle.js"] },
    "UserTimeout": { "type": "html-bundle", "marker": "USERTIMEOUT",                                                       "cssFile": "Components/UserTimeout/user-timeout.css", "jsFiles": ["Components/UserTimeout/user-timeout.js"] }
  },

  "subscribers": {
    "mindattic.com": {
      "kind":       "html-inline",
      "target":     "D:/Projects/MindAttic/mindattic.com/index.htm",
      "syncScript": "sync-mindattic-com.ps1",
      "subscriptions": [
        { "component": "Cyberspace"  }
      ]
    },

    "Prose.Writer": {
      "retired":   "2026-10-02: Prose was restructured; no v3/Prose.Writer Blazor wwwroot with UiUx marker blocks exists any more. Point target at the new project, add the marker pairs, and delete this field to re-enroll.",
      "kind":       "blazor-wwwroot",
      "target":     "D:/Projects/MindAttic/Prose/v3/Prose.Writer",
      "syncScript": "sync-prose.ps1",
      "subscriptions": [
        { "component": "OutfitFont" },
        { "component": "AtticFont",  "applyToSelector": null },
        { "component": "Cyberspace" },
        { "component": "PinFooter", "jsOnly": true },
        { "component": "UserLogin" },
        { "component": "UserCircle" },
        { "component": "UserTimeout" }
      ]
    },

    "Prose.Codex": {
      "retired":   "2026-10-02: Prose was restructured; no v3/Prose.Codex Blazor wwwroot with UiUx marker blocks exists any more. Point target at the new project, add the marker pairs, and delete this field to re-enroll.",
      "kind":       "blazor-wwwroot",
      "target":     "D:/Projects/MindAttic/Prose/v3/Prose.Codex",
      "syncScript": "sync-prose.ps1",
      "subscriptions": [
        { "component": "OutfitFont" },
        { "component": "AtticFont",  "applyToSelector": null },
        { "component": "Cyberspace" },
        { "component": "PinFooter", "jsOnly": true },
        { "component": "UserLogin" },
        { "component": "UserCircle" },
        { "component": "UserTimeout" }
      ]
    },

    "MindAttic.Psst.Legal": {
      "kind":       "html-inline-multi",
      "target":     "D:/Projects/MindAttic/MindAttic.Psst",
      "targets":    ["privacy.htm", "terms.htm"],
      "syncScript": "sync-mindattic-psst.ps1",
      "subscriptions": [
        { "component": "OutfitFont" }
      ]
    },

    "Ideas": {
      "$comment":   "MindAttic.Ideas Blazor CMS. Splice-in-place like Tutor. Retired: the MindAttic.Ideas.Web project no longer exists (see retired).",
      "retired":   "2026-10-02: the MindAttic.Ideas.Web project no longer exists. Point target at its successor, add the marker pairs, and delete this field to re-enroll.",
      "kind":       "blazor-wwwroot",
      "target":     "D:/Projects/MindAttic/MindAttic.Ideas/src/MindAttic.Ideas.Web",
      "syncScript": "sync-ideas.ps1",
      "subscriptions": [
        { "component": "UserLogin" },
        { "component": "UserCircle" },
        { "component": "UserTimeout" }
      ]
    },

    "Tutor": {
      "$comment":   "Tutor Blazor study app. Splice-in-place (CSS marker blocks in wwwroot/app.css, JS copied to wwwroot/js). Enrolled in the auth-visual trio (UserLogin, UserCircle, UserTimeout); local sync only (sync-tutor.ps1) -- the GitHub workflow has no Tutor job.",
      "kind":       "blazor-wwwroot",
      "target":     "D:/Projects/MindAttic/Tutor/Tutor.Blazor",
      "syncScript": "sync-tutor.ps1",
      "subscriptions": [
        { "component": "UserLogin" },
        { "component": "UserCircle" },
        { "component": "UserTimeout" }
      ]
    }
  }
}
